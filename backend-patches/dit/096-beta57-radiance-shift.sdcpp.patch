@@ -2,6 +2,7 @@
 
 #include <algorithm>
 #include <cmath>
+#include <cstdio>
 #include <cstdlib>
 #include <ctime>
 
@@ -94,9 +95,44 @@ namespace sd::pipeline {
         return sample_method;
     }
 
+    // nightmare (dit/096): the private backend's suffix whitelist can't carry a new
+    // schedule name down to the engine (an unknown suffix downgrades the whole
+    // sampler on the backend side), so Kotlin writes the schedule it picked into
+    // NM_DIT_SCHEDULE_FILE and sends a whitelisted suffix on the wire. Read fresh on
+    // every resolve — the file, not the launch environment, is what changes between
+    // renders. Anything unreadable or unmatchable falls back to the wire's value.
+    static scheduler_t resolve_schedule_file(scheduler_t scheduler) {
+        const char* path = getenv("NM_DIT_SCHEDULE_FILE");
+        if (!path || !path[0]) {
+            return scheduler;
+        }
+        FILE* f = fopen(path, "r");
+        if (!f) {
+            return scheduler;
+        }
+        char buf[32] = {0};
+        const bool read = fgets(buf, sizeof(buf), f) != nullptr;
+        fclose(f);
+        if (!read) {
+            return scheduler;
+        }
+        for (char* p = buf; *p; ++p) {
+            if (*p == '\n' || *p == '\r' || *p == ' ' || *p == '\t') {
+                *p = '\0';
+                break;
+            }
+        }
+        const scheduler_t from_file = str_to_scheduler(buf);
+        if (from_file == SCHEDULER_COUNT) {
+            return scheduler;
+        }
+        LOG_INFO("NM_DIT_SCHEDULE_FILE picks the '%s' scheduler", buf);
+        return from_file;
+    }
     static scheduler_t resolve_scheduler(StableDiffusionGGML* sd,
                                          scheduler_t scheduler,
                                          enum sample_method_t sample_method) {
+        scheduler = resolve_schedule_file(scheduler);
         if (scheduler == SCHEDULER_COUNT) {
             return default_scheduler(sd, sample_method);
         }
