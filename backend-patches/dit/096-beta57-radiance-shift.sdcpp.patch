+// nightmare (dit/096): ComfyUI-UtilsCollection's `radiance_shift_scheduler`
+// (helpers/scheduler_helpers.py, power=2.4, midpoint_shift=0.98), verbatim
+// structure: steps+1 points over [0, 1) (endpoint=False), x**midpoint_shift,
+// (1 - x**power)**power, rint to timesteps, consecutive-dedup, then
+// `discard_penultimate` drops the LAST positive survivor before the trailing
+// zero — so this table ships FINAL and nothing downstream trims another sigma
+// off it. ComfyUI indexes a 1001-rung ladder (sigmas[0..1000], 1000 == full
+// noise); this engine's is 1000 rungs deep, so the house translation — the one
+// BetaScheduler above already uses for the same ComfyUI shape — rescales the
+// normalized curve onto [0, TIMESTEPS-1] instead of indexing it raw. The
+// community's pick for dpmpp_2m_sde / dpmpp_sde on MOSS and Anima: it holds the
+// high-noise end longer than discrete or Karras before sliding down.
+struct RadianceShiftScheduler : SigmaScheduler {
+    std::vector<float> get_sigmas(uint32_t n, float /*sigma_min*/, float /*sigma_max*/, t_to_sigma_t t_to_sigma) override {
+        std::vector<float> result;
+        result.reserve(n + 2);
+        const int t_max = TIMESTEPS - 1;
+        if (n == 0) {
+            return result;
+        }
+        int last_t = -1;
+        for (uint32_t i = 0; i <= n; i++) {
+            const double x  = std::pow(static_cast<double>(i) / (static_cast<double>(n) + 1.0), 0.98);
+            const double ts = std::pow(1.0 - std::pow(x, 2.4), 2.4);
+            const int t     = static_cast<int>(std::lround(ts * t_max));
+
+            if (t != last_t) {
+                result.push_back(t_to_sigma(static_cast<float>(t)));
+                last_t = t;
+            }
+        }
+        // `discard_penultimate=True`: the last positive survivor goes, the
+        // trailing zero stays — the sampler still sees n steps when nothing
+        // deduped away, exactly ComfyUI's shape.
+        if (result.size() > 1) {
+            result.pop_back();
+        }
+        result.push_back(0.f);
+        return result;
+    }
+};
+
 struct SimpleScheduler : SigmaScheduler {
     std::vector<float> get_sigmas(uint32_t n, float sigma_min, float sigma_max, t_to_sigma_t t_to_sigma) override {
         std::vector<float> result_sigmas;
@@ -1071,6 +1113,17 @@ struct Denoiser {
                 LOG_INFO("get_sigmas with Beta scheduler");
                 scheduler = std::make_shared<BetaScheduler>(extra_sample_args);
                 break;
+            // nightmare (dit/096): RES4LYF's "beta57" handler — the generic Beta scheduler
+            // with the shape the community actually runs (alpha=0.5, beta=0.7; RES4LYF
+            // sigmas.py:1422). The parseable-args Beta above stays as it is.
+            case BETA57_SCHEDULER:
+                LOG_INFO("get_sigmas with Beta 57 scheduler (alpha=0.5, beta=0.7)");
+                scheduler = std::make_shared<BetaScheduler>("alpha=0.5,beta=0.7");
+                break;
+            case RADIANCE_SHIFT_SCHEDULER:
+                LOG_INFO("get_sigmas with Radiance Shift scheduler");
+                scheduler = std::make_shared<RadianceShiftScheduler>();
+                break;
 
             case EXPONENTIAL_SCHEDULER:
